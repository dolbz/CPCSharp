             xmlns:local="clr-namespace:CPCSharp"
             x:Class="CPCSharp.App.App"
             RequestedThemeVariant="Light">
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About CPC#" Click="OpenAbout" />
            <!--<NativeMenuItemSeperator />
            <NativeMenuItem Header="Preferences..." Command="{Binding OpenPreferences}">
