<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CPCSharp.App.ViewModels;assembly=CPCSharp.App"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="CPCSharp.App.Views.MemoryNavigator"
        xmlns:conv="clr-namespace:CPCSharp.App.ValueConverters"
        Title="Memory"
        Width="1000" Height="700"
        MinWidth="600" MinHeight="400">
  <Design.DataContext>
    <vm:Memory/>
  </Design.DataContext>
  <Window.Resources>
    <conv:ByteHexValueConverter x:Key="ByteHexValueConverter" />
    <conv:ShortHexValueConverter x:Key="ShortHexValueConverter" />
  </Window.Resources>
  <Grid RowDefinitions="*,Auto">
    <ListBox Grid.Row="0" FontFamily="Menlo, Monaco, 'Courier New', monospace" ItemsSource="{Binding RamListing}" SelectedIndex="{Binding SelectedRamIndex}" AutoScrollToSelectedItem="True">
      <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" />
          </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Border Grid.Row="1" Padding="8,6" BorderThickness="0,1,0,0" BorderBrush="#20000000">
      <Button Command="{Binding DumpRam}" Content="Dump Memory" Padding="10,4"/>
    </Border>
  </Grid>
</Window>
